# GradPath Atlas environment template
# Replace placeholders in your local environment only; never commit real secrets.

# Application and target database
NEXT_PUBLIC_APP_URL=https://example.invalid
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_REPLACE_WITH_CLERK_WEBHOOK_SECRET

# Stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_SEASON_PASS=price_REPLACE_WITH_STRIPE_PRICE_ID

# ImageKit — only if/when feature is enabled
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/REPLACE_WITH_IMAGEKIT_ID
IMAGEKIT_PUBLIC_KEY=public_REPLACE_WITH_IMAGEKIT_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=private_REPLACE_WITH_IMAGEKIT_PRIVATE_KEY

# Gemini — optional, server-side, deferred
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
